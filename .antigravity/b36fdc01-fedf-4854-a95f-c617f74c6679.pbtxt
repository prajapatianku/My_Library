    instruction: "Update generateInitialAttendance to seed multi-day attendance with PRESENT and ABSENT"
    replacement_infos {
      original_chunk {
        target_content: "    private fun generateInitialAttendance(): List<AttendanceRecord> {\n        val today = SimpleDateFormat(\"yyyy-MM-dd\", Locale.getDefault()).format(Date())\n        return listOf(\n            AttendanceRecord(studentId = \"s1\", studentName = \"Aryan Patel\", studentCode = \"STU-001\", shiftName = \"Full Day\", seatNumber = \"A-1\", attendanceDate = today, checkInTime = \"06:45 AM\", status = AttendanceStatus.PRESENT),\n            AttendanceRecord(studentId = \"s2\", studentName = \"Priya Rajput\", studentCode = \"STU-002\", shiftName = \"Morning Shift\", seatNumber = \"A-2\", attendanceDate = today, checkInTime = \"07:10 AM\", status = AttendanceStatus.PRESENT),\n            AttendanceRecord(studentId = \"s3\", studentName = \"Rohan Chaudhary\", studentCode = \"STU-003\", shiftName = \"Evening Shift\", seatNumber = \"A-3\", attendanceDate = today, checkInTime = null, status = AttendanceStatus.ABSENT),\n            AttendanceRecord(studentId = \"s4\", studentName = \"Sneha Gupta\", studentCode = \"STU-004\", shiftName = \"Full Day\", seatNumber = \"A-4\", attendanceDate = today, checkInTime = \"08:00 AM\", status = AttendanceStatus.PRESENT),\n            AttendanceRecord(studentId = \"s5\", studentName = \"Vikas Yadav\", studentCode = \"STU-005\", shiftName = \"Afternoon Shift\", seatNumber = \"A-5\", attendanceDate = today, checkInTime = null, status = AttendanceStatus.LEAVE),\n            AttendanceRecord(studentId = \"s6\", studentName = \"Ananya Singh\", studentCode = \"STU-006\", shiftName = \"Full Day\", seatNumber = \"A-6\", attendanceDate = today, checkInTime = \"07:30 AM\", status = AttendanceStatus.PRESENT),\n            AttendanceRecord(studentId = \"s7\", studentName = \"Deepak Kumar\", studentCode = \"STU-007\", shiftName = \"Morning Shift\", seatNumber = \"A-7\", attendanceDate = today, checkInTime = \"08:15 AM\", status = AttendanceStatus.LATE),\n            AttendanceRecord(studentId = \"s8\", studentName = \"Kavita Meena\", studentCode = \"STU-008\", shiftName = \"Evening Shift\", seatNumber = \"A-8\", attendanceDate = today, checkInTime = \"05:05 PM\", status = AttendanceStatus.PRESENT)\n        )\n    }"
        replacement_content: "    private fun generateInitialAttendance(): List<AttendanceRecord> {\n        val sdf = SimpleDateFormat(\"yyyy-MM-dd\", Locale.getDefault())\n        val cal = Calendar.getInstance()\n        val dates = (0..4).map { offset ->\n            cal.time = Date()\n            cal.add(Calendar.DAY_OF_YEAR, -offset)\n            sdf.format(cal.time)\n        } // dates[0]=today, dates[1]=yesterday, dates[2]=2 days ago, dates[3]=3 days ago, dates[4]=4 days ago\n\n        val studentsData = listOf(\n            Triple(\"s1\", \"Aryan Patel\", \"STU-001\"),\n            Triple(\"s2\", \"Priya Rajput\", \"STU-002\"),\n            Triple(\"s3\", \"Rohan Chaudhary\", \"STU-003\"),\n            Triple(\"s4\", \"Sneha Gupta\", \"STU-004\"),\n            Triple(\"s5\", \"Vikas Yadav\", \"STU-005\"),\n            Triple(\"s6\", \"Ananya Singh\", \"STU-006\"),\n            Triple(\"s7\", \"Deepak Kumar\", \"STU-007\"),\n            Triple(\"s8\", \"Kavita Meena\", \"STU-008\")\n        )\n\n        val list = mutableListOf<AttendanceRecord>()\n        dates.forEachIndexed { dateIdx, dateStr ->\n            studentsData.forEachIndexed { stuIdx, (id, name, code) ->\n                // Deterministic realistic attendance status (Present / Absent)\n                val isPresent = (stuIdx + dateIdx) % 4 != 0\n                list.add(\n                    AttendanceRecord(\n                        studentId = id,\n                        studentName = name,\n                        studentCode = code,\n                        shiftName = if (stuIdx % 2 == 0) \"Full Day\" else \"Morning Shift\",\n                        seatNumber = \"A-${stuIdx + 1}\",\n                        attendanceDate = dateStr,\n                        checkInTime = if (isPresent) \"07:30 AM\" else null,\n                        status = if (isPresent) AttendanceStatus.PRESENT else AttendanceStatus.ABSENT\n                    )\n                )\n            }\n        }\n        return list\n    }"
      }
      num_matches: 1
    }
  }
}
