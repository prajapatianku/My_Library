        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Student Attendance List"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        LazyColumn("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            modifier = Modifier.fillMaxSize(),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            contentPadding = PaddingValues(start = 16.dp, end = 16.dp, bottom = 100.dp, top = 4.dp),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            verticalArrangement = Arrangement.spacedBy(8.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        ) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            items(filteredStudents) { student ->"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                val currentRecord = todayRecords.find { it.studentId == student.id }"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                val currentStatus = currentRecord?.status ?: AttendanceStatus.PRESENT"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                val currentRecord = selectedDateRecords.find { it.studentId == student.id }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                val currentStatus = currentRecord?.status ?: AttendanceStatus.ABSENT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                val isMarked = currentRecord != null"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                AttendanceItemCard("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    student = student,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    currentStatus = currentStatus,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    isMarked = isMarked,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    isEditable = isEditable,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    onStatusChange = { newStatus ->"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        viewModel.markAttendance(student.id, newStatus)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                        viewModel.markAttendance(student.id, newStatus, selectedDateIso)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
