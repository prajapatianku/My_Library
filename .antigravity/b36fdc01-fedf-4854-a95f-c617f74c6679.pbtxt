          text: "                                                border = FilterChipDefaults.filterChipBorder("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                                    enabled = true,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
