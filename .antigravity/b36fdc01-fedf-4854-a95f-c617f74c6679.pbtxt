          text: "                                    ) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                        listOf(40, 60, 80, 100, 150).forEach { cap ->"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
