          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            border = androidx.compose.foundation.BorderStroke(1.dp, Color(0xFFF3ECE4))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
