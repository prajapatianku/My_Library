          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                                border = FilterChipDefaults.filterChipBorder("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                                    enabled = true,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                                    selected = seatsCapacity == cap,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                                    borderColor = if (seatsCapacity == cap) OrangePrimary else Color(0xFFE5DECE)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
