          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val selectedDateRecords = attendanceRecords.filter { it.attendanceDate == selectedDateIso }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val presentCount = selectedDateRecords.count { it.status == AttendanceStatus.PRESENT }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val absentCount = selectedDateRecords.count { it.status == AttendanceStatus.ABSENT }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val totalStudents = students.size"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val attendancePct = if (totalStudents > 0) (presentCount * 100) / totalStudents else 0"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val shiftFilterOptions = listOf(\"All\") + shifts.map { it.name }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val filteredStudents = if (selectedShift == \"All\") {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
