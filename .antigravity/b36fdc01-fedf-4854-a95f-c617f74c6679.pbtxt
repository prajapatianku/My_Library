        lines {
          text: "    // Computed Dashboard KPI Metrics"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val dashboardMetrics: StateFlow<DashboardMetrics> = combine("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        combine(students, seats) { stu, seat -> Pair(stu, seat) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        combine(attendance, payments) { att, pay -> Pair(att, pay) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        combine(expenses, registrationRequests) { exp, req -> Pair(exp, req) }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    ) { (stuList, seatList), (attList, payList), (expList, reqList) ->"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val today = dateFormat.format(Date())"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val activeStu = stuList.count { it.status == StudentStatus.ACTIVE }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val presentToday = attList.count { it.attendanceDate == today && it.status == AttendanceStatus.PRESENT }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val absentToday = attList.count { it.attendanceDate == today && it.status == AttendanceStatus.ABSENT }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val occupied = seatList.count { it.status == SeatStatus.OCCUPIED }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val totalSeats = seatList.size"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val availableSeats = totalSeats - occupied"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val todayCol = payList.filter { it.paymentDate == today }.sumOf { it.amount }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val monthCol = payList.sumOf { it.amount }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val totalExp = expList.sumOf { it.amount }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val netRev = monthCol - totalExp"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val pendingDues = stuList.sumOf { it.dueAmount }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val expiring = stuList.count { it.dueAmount > 0 || it.status == StudentStatus.EXPIRED }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        val pendingReqs = reqList.count { it.status == \"pending\" }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        DashboardMetrics("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            activeStudentsCount = activeStu,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            presentTodayCount = presentToday,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            absentTodayCount = absentToday,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            occupiedSeatsCount = occupied,"
