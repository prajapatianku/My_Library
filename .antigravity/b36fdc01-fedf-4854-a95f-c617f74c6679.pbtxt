        }
        lines {
          text: "                    items(shiftFilterOptions) { shift ->"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        FilterChip("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            selected = selectedShift == shift,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            onClick = { viewModel.setAttendanceShiftFilter(shift) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            label = { Text(shift) },"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                            shape = RoundedCornerShape(20.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                            label = { Text(shift, fontWeight = if (selectedShift == shift) FontWeight.Bold else FontWeight.Normal) },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            shape = RoundedCornerShape(20.dp),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
