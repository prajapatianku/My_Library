         ) {\n                    KpiMetricCard(\n                        title = \"Active Students\",\n                        value = \"${metrics.activeStudentsCount}\",\n                        subtitle = \"Total enrolled\",\n                        icon = Icons.Default.People,\n                        iconBgColor = NavyPrimaryContainer,\n                        iconTintColor = NavyPrimary,\n                        modifier = Modifier.weight(1f),\n                        onClick = onNavigateToStudents\n                    )\n\n                    KpiMetricCard(\n                        title = \"Present Today\",\n                        value = \"${metrics.presentTodayCount}\",\n                        subtitle = \"${metrics.absentTodayCount} Absent / Leave\",\n                        icon = Icons.Default.CheckCircle,\n                        iconBgColor = Color(0xFFD1FAE5),\n                        iconTintColor = SuccessGreen,\n                        modifier = Modifier.weight(1f),\n                        onClick = onNavigateToAttendance\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(10.dp))\n\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(10.dp)\n                ) {\n                    KpiMetricCard(\n                        title = \"Seats Occupancy\",\n                        value = \"${metrics.occupiedSeatsCount}/${metrics.totalSeatsCount}\",\n                        subtitle = \"${metrics.availableSeatsCount} seats available\",\n                        icon = Icons.Default.Chair,\n                        iconBgColor = AmberTertiaryContainer,\n                        iconTintColor = AmberTertiary,\n                        modifier = Modifier.weight(1f),\n                        onClick = onNavigateToSeats\n                    )\n\n                    KpiMetricCard(\n                        title = \"Fee Dues\",\n                        value = \"\342\202\271${metrics.pendingDues}\",\n                        subtitle = \"${metrics.expiringCount} students pending\",\n                        icon = Icons.Default.AttachMoney,\n                        iconBgColor = Color(0xFFFEE2E2),\n                        iconTintColor = DangerRed,\n                        modifier = Modifier.weight(1f),\n                        onClick = onNavigateToStudents\n                    )\n                }\n            }\n        }\n\n        // Quick Actions Section\n        item {\n            Spacer(modifier = Modifier.height(20.dp))\n            Column(modifier = Modifier.padding(horizontal = 16.dp)) {\n                Text(\n                    text = \"Quick Actions\",\n                    style = MaterialTheme.typography.titleMedium,\n                    fontWeight = FontWeight.Bold,\n                    color = MaterialTheme.colorScheme.onSurface\n                )\n                Spacer(modifier = Modifier.height(12.dp))\n\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    QuickActionCard(\n                        title = \"+ Student\",\n                        icon = Icons.Default.PersonAdd,\n                        color = NavyPrimary,\n                        onClick = { viewModel.showAddStudentDialog(true) },\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"Attendance\",\n                        icon = Icons.Default.AssignmentTurnedIn,\n                        color = TealSecondary,\n                        onClick = onNavigateToAttendance,\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"Collect Fee\",\n                        icon = Icons.Default.Payments,\n                        color = SuccessGreen,\n                        onClick = {\n                            val dueStudent = students.find { it.dueAmount > 0 } ?: students.firstOrNull()\n                            viewModel.showCollectFeeDialog(dueStudent)\n                        },\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"Seat Map\",\n                        icon = Icons.Default.GridView,\n                        color = AmberTertiary,\n                        onClick = onNavigateToSeats,\n                        modifier = Modifier.weight(1f)\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    QuickActionCard(\n                        title = \"+ Expense\",\n                        icon = Icons.Default.ReceiptLong,\n                        color = Color(0xFF9333EA),\n                        onClick = { viewModel.showAddExpenseDialog(true) },\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"Public QR\",\n                        icon = Icons.Default.QrCode2,\n                        color = Color(0xFF0284C7),\n                        onClick = { viewModel.showQrDialog(true) },\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"Reports\",\n                        icon = Icons.Default.BarChart,\n                        color = Color(0xFFE11D48),\n                        onClick = onNavigateToReports,\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"All Present\",\n                        icon = Icons.Default.DoneAll,\n                        color = Color(0xFF059669),\n                        onClick = { viewModel.markAllPresent() },\n                        modifier = Modifier.weight(1f)\n                    )\n                }\n            }\n        }"
      replacement_content: "                        Row(\n                            modifier = Modifier.fillMaxWidth(),\n                            horizontalArrangement = Arrangement.SpaceBetween\n                        ) {\n                            Column {\n                                Text(text = \"This Month\", fontSize = 11.sp, color = Color.White.copy(alpha = 0.7f))\n                                Text(text = \"\342\202\271${metrics.monthlyCollection}\", fontSize = 14.sp, fontWeight = FontWeight.Bold, color = Color.White)\n                            }\n                            Column(\n                                modifier = Modifier\n                                    .clip(RoundedCornerShape(8.dp))\n                                    .clickable { onNavigateToExpenses() }\n                                    .padding(horizontal = 4.dp, vertical = 2.dp)\n                            ) {\n                                Text(text = \"Expenses \342\206\227\", fontSize = 11.sp, color = Color.White.copy(alpha = 0.7f))\n                                Text(text = \"\342\202\271${metrics.totalExpenses}\", fontSize = 14.sp, fontWeight = FontWeight.Bold, color = Color(0xFFFCA5A5))\n                            }\n                            Column(\n                                modifier = Modifier\n                                    .clip(RoundedCornerShape(8.dp))\n                                    .clickable { onNavigateToStudents() }\n                                    .padding(horizontal = 4.dp, vertical = 2.dp)\n                            ) {\n                                Text(text = \"Pending Dues \342\206\227\", fontSize = 11.sp, color = Color.White.copy(alpha = 0.7f))\n                                Text(text = \"\342\202\271${metrics.pendingDues}\", fontSize = 14.sp, fontWeight = FontWeight.Bold, color = Color(0xFFFDE047))\n                            }\n                        }\n                    }\n                }\n            }\n        }\n\n        // Live Operational KPI Cards (Grid)\n        item {\n            Column(modifier = Modifier.padding(horizontal = 16.dp)) {\n                Text(\n                    text = \"Library Status Today\",\n                    style = MaterialTheme.typography.titleMedium,\n                    fontWeight = FontWeight.Bold,\n                    color = MaterialTheme.colorScheme.onSurface\n                )\n                Spacer(modifier = Modifier.height(10.dp))\n\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(10.dp)\n                ) {\n                    KpiMetricCard(\n                        title = \"Active Students\",\n                        value = \"${metrics.activeStudentsCount}\",\n                        subtitle = \"Total enrolled\",\n                        icon = Icons.Default.People,\n                        iconBgColor = NavyPrimaryContainer,\n                        iconTintColor = NavyPrimary,\n                        modifier = Modifier.weight(1f),\n                        onClick = onNavigateToStudents\n                    )\n\n                    KpiMetricCard(\n                        title = \"Present Today\",\n                        value = \"${metrics.presentTodayCount}\",\n                        subtitle = \"${metrics.absentTodayCount} Absent\",\n                        icon = Icons.Default.CheckCircle,\n                        iconBgColor = Color(0xFFD1FAE5),\n                        iconTintColor = SuccessGreen,\n                        modifier = Modifier.weight(1f),\n                        onClick = onNavigateToAttendance\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(10.dp))\n\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(10.dp)\n                ) {\n                    KpiMetricCard(\n                        title = \"Seats Occupancy\",\n                        value = \"${metrics.occupiedSeatsCount}/${metrics.totalSeatsCount}\",\n                        subtitle = \"${metrics.availableSeatsCount} seats available\",\n                        icon = Icons.Default.Chair,\n                        iconBgColor = AmberTertiaryContainer,\n                        iconTintColor = AmberTertiary,\n                        modifier = Modifier.weight(1f),\n                        onClick = onNavigateToSeats\n                    )\n\n                    KpiMetricCard(\n                        title = \"Fee Dues\",\n                        value = \"\342\202\271${metrics.pendingDues}\",\n                        subtitle = \"${metrics.expiringCount} students pending\",\n                        icon = Icons.Default.AttachMoney,\n                        iconBgColor = Color(0xFFFEE2E2),\n                        iconTintColor = DangerRed,\n                        modifier = Modifier.weight(1f),\n                        onClick = onNavigateToStudents\n                    )\n                }\n            }\n        }\n\n        // Quick Actions Section\n        item {\n            Spacer(modifier = Modifier.height(20.dp))\n            Column(modifier = Modifier.padding(horizontal = 16.dp)) {\n                Text(\n                    text = \"Quick Actions\",\n                    style = MaterialTheme.typography.titleMedium,\n                    fontWeight = FontWeight.Bold,\n                    color = MaterialTheme.colorScheme.onSurface\n                )\n                Spacer(modifier = Modifier.height(12.dp))\n\n                // Primary Management Actions (Students, + Student, Expenses, + Expense)\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    QuickActionCard(\n                        title = \"Students\",\n                        icon = Icons.Default.People,\n                        color = NavyPrimary,\n                        onClick = onNavigateToStudents,\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"+ Student\",\n                        icon = Icons.Default.PersonAdd,\n                        color = Color(0xFF1D4ED8),\n                        onClick = { viewModel.showAddStudentDialog(true) },\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"Expenses\",\n                        icon = Icons.Default.ReceiptLong,\n                        color = Color(0xFF9333EA),\n                        onClick = onNavigateToExpenses,\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"+ Expense\",\n                        icon = Icons.Default.AddCard,\n                        color = Color(0xFF7C3AED),\n                        onClick = { viewModel.showAddExpenseDialog(true) },\n                        modifier = Modifier.weight(1f)\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                // Operations Actions (Attendance, Collect Fee, Seat Map, Reports)\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    QuickActionCard(\n                        title = \"Attendance\",\n                        icon = Icons.Default.AssignmentTurnedIn,\n                        color = TealSecondary,\n                        onClick = onNavigateToAttendance,\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"Collect Fee\",\n                        icon = Icons.Default.Payments,\n                        color = SuccessGreen,\n                        onClick = {\n                            val dueStudent = students.find { it.dueAmount > 0 } ?: students.firstOrNull()\n                            viewModel.showCollectFeeDialog(dueStudent)\n                        },\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"Seat Map\",\n                        icon = Icons.Default.GridView,\n                        color = AmberTertiary,\n                        onClick = onNavigateToSeats,\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"Reports\",\n                        icon = Icons.Default.BarChart,\n                        color = Color(0xFFE11D48),\n                        onClick = onNavigateToReports,\n                        modifier = Modifier.weight(1f)\n                    )\n                }\n\n                Spacer(modifier = Modifier.height(8.dp))\n\n                // Utility Actions (Public QR, All Present)\n                Row(\n                    modifier = Modifier.fillMaxWidth(),\n                    horizontalArrangement = Arrangement.spacedBy(8.dp)\n                ) {\n                    QuickActionCard(\n                        title = \"Public QR\",\n                        icon = Icons.Default.QrCode2,\n                        color = Color(0xFF0284C7),\n                        onClick = { viewModel.showQrDialog(true) },\n                        modifier = Modifier.weight(1f)\n                    )\n                    QuickActionCard(\n                        title = \"All Present\",\n                        icon = Icons.Default.DoneAll,\n                        color = Color(0xFF059669),\n                        onClick = { viewModel.markAllPresent() },\n                        modifier = Modifier.weight(1f)\n                    )\n                }\n            }\n        }"
    }
