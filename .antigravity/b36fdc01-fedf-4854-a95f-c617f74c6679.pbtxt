          text: "                            ) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                RegSectionHeaderPill("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                    stepNumber = \"1\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                    title = \"Personal\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                    isActive = regSection == RegSection.PERSONAL_DETAILS,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                    isDone = regSection == RegSection.LIBRARY_DETAILS || regSection == RegSection.SHIFT_DETAILS,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                    onClick = { regSection = RegSection.PERSONAL_DETAILS },"
