        lines {
          text: "                                                .fillMaxWidth()"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                                .padding(vertical = 4.dp),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
