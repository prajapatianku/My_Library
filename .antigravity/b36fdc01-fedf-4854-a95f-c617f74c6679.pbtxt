        }
        lines {
          text: "    val selectedDateIso by viewModel.selectedAttendanceDate.collectAsState()"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val isoDateFormat = remember { SimpleDateFormat(\"yyyy-MM-dd\", Locale.getDefault()) }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val displayDateFormat = remember { SimpleDateFormat(\"EEEE, dd MMMM yyyy\", Locale.getDefault()) }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val shortDateFormat = remember { SimpleDateFormat(\"dd MMM yyyy\", Locale.getDefault()) }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    val selectedDateObj: Date = remember(selectedDateIso) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        try {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            isoDateFormat.parse(selectedDateIso) ?: Date()"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        } catch (e: Exception) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            Date()"
