        lines {
          text: "                                                if (err != null) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                                    validationError = err"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
