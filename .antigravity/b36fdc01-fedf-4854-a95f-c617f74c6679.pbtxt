        }
        lines {
          text: "    var amount by remember { mutableStateOf(if (student.dueAmount > 0) student.dueAmount.toString() else student.monthlyFee.toString()) }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var discount by remember { mutableStateOf(\"0\") }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    var selectedMethod by remember { mutableStateOf(PaymentMethod.UPI) }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
