        lines {
          text: "            netRevenue = netRev,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            pendingDues = pendingDues,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            expiringCount = expiring,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
